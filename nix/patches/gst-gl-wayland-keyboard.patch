+{
+}
+
+static void
+keyboard_handle_key (void *data, struct wl_keyboard *keyboard,
+    uint32_t serial, uint32_t time, uint32_t key, uint32_t state)
+{
+  GstGLWindowWaylandEGL *window_egl = data;
+  struct display *display = &window_egl->display;
+  GstGLWindow *window = GST_GL_WINDOW (window_egl);
+  xkb_keysym_t sym;
+  char name[64];
+
+  if (!display->xkb_state)
+    return;
+
+  /* wl_keyboard reports evdev keycodes; xkbcommon expects them offset by 8. */
+  sym = xkb_state_key_get_one_sym (display->xkb_state, key + 8);
+  if (sym == XKB_KEY_NoSymbol)
+    return;
+  if (xkb_keysym_get_name (sym, name, sizeof (name)) <= 0)
+    return;
+
+  gst_gl_window_send_key_event (window,
+      state == WL_KEYBOARD_KEY_STATE_PRESSED ? "key-press" : "key-release",
+      name);
+}
+
+static void
+keyboard_handle_modifiers (void *data, struct wl_keyboard *keyboard,
+    uint32_t serial, uint32_t mods_depressed, uint32_t mods_latched,
+    uint32_t mods_locked, uint32_t group)
+{
+  GstGLWindowWaylandEGL *window_egl = data;
+  struct display *display = &window_egl->display;
+
+  if (!display->xkb_state)
+    return;
+
+  xkb_state_update_mask (display->xkb_state, mods_depressed, mods_latched,
+      mods_locked, 0, 0, group);
+}
+
+static void
+keyboard_handle_repeat_info (void *data, struct wl_keyboard *keyboard,
+    int32_t rate, int32_t delay)
+{
+}
+
+static const struct wl_keyboard_listener keyboard_listener = {
+  keyboard_handle_keymap,
+  keyboard_handle_enter,
+  keyboard_handle_leave,
+  keyboard_handle_key,
+  keyboard_handle_modifiers,
+  keyboard_handle_repeat_info,
+};
