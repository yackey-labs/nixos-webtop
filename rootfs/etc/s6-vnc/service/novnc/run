#!/bin/bash
# noVNC in front of wayvnc, as user abc: websockify's proxy plus its static
# file server, serving the noVNC web client. A browser at
# http://host:NOVNC_PORT/ lands on the desktop with no client install;
# native clients use the plain VNC port directly.
#
# websockify is invoked directly (not via the `novnc` wrapper): under s6
# the proxy must be an exec-able foreground process -- the wrapper starts
# websockify in the background and waits on it, and its missing-dependency
# fallback tries a `git clone`; neither belongs in a service script. (The
# wrapper's baked websockify store path does exist in this image -- both
# come from the same nixpkgs revision -- so that is not the reason.) The
# web files still come from the `novnc` package
# (/usr/share/webapps/novnc).
RUNTIME="${XDG_RUNTIME_DIR:-/run/user/911}"
PORT="${NOVNC_PORT:-6080}"
LISTEN="${NOVNC_LISTEN:-0.0.0.0}"
VNC_PORT="${VNC_PORT:-5900}"

# noVNC serves its client at /vnc.html, not at /. Assemble a writable copy
# of its web tree (1.7 MB) with an index page that forwards to the client
# with sane defaults: autoconnect, scale-to-window, reconnect on drop. The
# password (when VNC_PASSWORD is set) is deliberately NOT embedded: noVNC
# prompts for it.
WEBDIR="$RUNTIME/novnc-web"
if [ ! -f "$WEBDIR/vnc.html" ]; then
  rm -rf "$WEBDIR"
  mkdir -p "$WEBDIR"
  cp -rL /usr/share/webapps/novnc/. "$WEBDIR"/
  cat > "$WEBDIR/index.html" <<'HTML'
<!DOCTYPE html>
<html><head><meta charset="utf-8">
<meta http-equiv="refresh" content="0; url=vnc.html?autoconnect=true&amp;resize=scale&amp;reconnect=true">
<title>scoot VNC desktop</title></head>
<body><p><a href="vnc.html?autoconnect=true&amp;resize=scale&amp;reconnect=true">Open the desktop</a></p></body></html>
HTML
fi

echo "[novnc] serving http://$LISTEN:$PORT/ -> localhost:$VNC_PORT" >&2
exec s6-setuidgid abc websockify --web "$WEBDIR" "$LISTEN:$PORT" "localhost:$VNC_PORT"
