#!/bin/bash
# Container entrypoint. Does the one-shot setup linuxserver's init-* s6 stages
# do, then execs s6-svscan as PID 1 to supervise the long-running services.
set -u

log() { echo "[init] $*"; }

log "Nix-built Selkies image starting (title: ${TITLE:-Selkies})"

PUID="${PUID:-911}"
PGID="${PGID:-911}"

# ---- user / group mapping ------------------------------------------------
if [ "$(id -g abc)" != "$PGID" ]; then groupmod -o -g "$PGID" abc; fi
if [ "$(id -u abc)" != "$PUID" ]; then usermod -o -u "$PUID" abc; fi
log "abc uid=$(id -u abc) gid=$(id -g abc)"

# ---- directories ---------------------------------------------------------
mkdir -p /config /run/service /run/pulse /run/dbus /run/nginx /run/selkies \
         /tmp/.X11-unix /tmp/.ICE-unix /var/log/nginx /var/lib/nginx
chmod 1777 /tmp /tmp/.X11-unix /tmp/.ICE-unix
chown abc:abc /run/pulse /run/dbus /run/selkies
chown abc:abc /config
if [ "${SKIP_CHOWN_CONFIG:-false}" != "true" ]; then
  chown -R abc:abc /config 2>/dev/null || true
fi
# abc-owned homes for XDG state: some services run as root and create
# /config/.local/state as root on their first start, which would leave abc's
# own state writers (scootbg's per-profile wallpaper restore, ...) unable to
# create their directories underneath it. Pre-create them here, while this
# script is still root and before s6-svscan starts the services; a root
# service can still write into an abc-owned parent, but not vice versa.
mkdir -p /config/.local/bin /config/.local/share /config/.local/state
chown -R abc:abc /config/.local

export XDG_RUNTIME_DIR="/run/user/${PUID}"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"
chown abc:abc "$XDG_RUNTIME_DIR"

[ -s /etc/machine-id ] || dbus-uuidgen > /etc/machine-id

# ---- default per-user config (first run) ---------------------------------
# Copy $1 onto $2 so the destination ends up user-writable even when either
# side is a read-only nix-store file (mode 444): plain `cp` opens an existing
# 444 destination in place and fails with Permission denied, so a later image
# update would never replace a seeded 444 copy. Unlink-first plus chmod fixes
# both halves.
install_default() { # src dst
  cp -L --remove-destination "$1" "$2" || return 1
  chmod u+w "$2" || return 1
}

# Nanosecond backup name with a collision loop (see startwm-scoot.sh): two
# updates inside one second must not overwrite the first backup.
backup_name() { # dst; prints a free <dst>.bak-<ts> path
  local ts suffix i
  ts=$(date +%s%N)
  suffix="$ts"
  i=0
  while [ -e "$1.bak-$suffix" ]; do
    i=$((i+1))
    suffix="${ts}-$i"
  done
  printf '%s.bak-%s' "$1" "$suffix"
}
CONF_DIR="$HOME/.config/openbox"
mkdir -p "$HOME/.config"
if [ ! -f "$CONF_DIR/autostart" ]; then
  if mkdir -p "$CONF_DIR" && install_default /defaults/autostart "$CONF_DIR/autostart"; then
    :
  else
    echo "[init] ERROR: seeding $CONF_DIR/autostart failed; skipping" >&2
  fi
fi
if [ ! -f "$CONF_DIR/menu.xml" ]; then
  if mkdir -p "$CONF_DIR" && install_default /defaults/menu.xml "$CONF_DIR/menu.xml"; then
    :
  else
    echo "[init] ERROR: seeding $CONF_DIR/menu.xml failed; skipping" >&2
  fi
fi
# Per-app config templates baked into the image (/defaults/config/<app> -> ~/.config/<app>).
#
# This used to be `if [ ! -d ~/.config/$app ]; then cp; fi`, which meant the
# copy happened exactly once, on the first ever boot with an empty /config. From
# then on the PVC's copy shadowed the image forever: a config fix could be
# built, shipped and deployed and still have no effect on a running desktop.
# That is how `Invalid dispatcher: togglesplit` survived a release that fixed it.
#
# Now we remember what we shipped, per file, in a manifest. That is the only way
# to distinguish "the user edited this" from "this is a stale copy of an old
# default", which the mtime and the file itself cannot tell you.
#
#   user's copy == what we last shipped   -> untouched, safe to update in place
#   user's copy == the new default        -> already current, just record it
#   otherwise                             -> the user edited it: keep theirs,
#                                            drop <file>.new beside it and warn
#
# First run after this change there is no manifest, so nothing can be classified.
# Rather than freeze every existing desktop on its old config, we adopt the
# shipped default and keep any differing file as <file>.bak-<timestamp>. Noisy
# but recoverable, and it self-corrects from the next boot onward.
STATE_DIR="$HOME/.local/state/nixos-webtop"
mkdir -p "$STATE_DIR"
for tpl in /defaults/config/*/; do
  [ -d "$tpl" ] || continue
  app=$(basename "$tpl")
  dest="$HOME/.config/$app"
  manifest="$STATE_DIR/shipped-$app.sha256"
  new_manifest="$manifest.next"
  : > "$new_manifest"
  had_manifest=0
  [ -f "$manifest" ] && had_manifest=1

  (cd "$tpl" && find . -type f -o -type l) | sed 's|^\./||' | while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    src="$tpl$rel"
    dst="$dest/$rel"
    new_sum=$(sha256sum "$src" 2>/dev/null | cut -d' ' -f1)
    # N4: never half-update the manifest. The new manifest line for this
    # file is appended only after its install succeeds; on any failure we
    # log loudly, skip the file, and carry the old manifest line (if any)
    # forward so the next boot retries instead of believing the new
    # default shipped.
    if [ -z "$new_sum" ]; then
      echo "[init] ERROR: $app/$rel: cannot read image default $src; skipping" >&2
      if [ "$had_manifest" -eq 1 ]; then
        awk -v r="$rel" '$2==r {print $0}' "$manifest" 2>/dev/null | head -1 >> "$new_manifest"
      fi
      continue
    fi

    if [ ! -f "$dst" ]; then
      if ! mkdir -p "$(dirname "$dst")"; then
        echo "[init] ERROR: $app/$rel: cannot create parent directory; skipping" >&2
        continue
      fi
      if ! install_default "$src" "$dst"; then
        echo "[init] ERROR: $app/$rel: install_default failed; skipping" >&2
        continue
      fi
      printf '%s  %s\n' "$new_sum" "$rel" >> "$new_manifest"
      continue
    fi

    cur_sum=$(sha256sum "$dst" 2>/dev/null | cut -d' ' -f1)
    if [ "$cur_sum" = "$new_sum" ]; then
      printf '%s  %s\n' "$new_sum" "$rel" >> "$new_manifest"
      continue
    fi

    if [ "$had_manifest" -eq 0 ]; then
      if ! bak=$(backup_name "$dst"); then
        echo "[init] ERROR: $app/$rel: backup_name failed; skipping" >&2
        continue
      fi
      echo "[init] $app/$rel differs from the image default and predates config tracking; keeping yours as $(basename "$bak")"
      if ! cp -L "$dst" "$bak"; then
        echo "[init] ERROR: $app/$rel: backup copy to $bak failed; skipping (leaving yours in place)" >&2
        continue
      fi
      if ! install_default "$src" "$dst"; then
        echo "[init] ERROR: $app/$rel: install_default failed after backup (backup kept at $bak); skipping" >&2
        continue
      fi
      printf '%s  %s\n' "$new_sum" "$rel" >> "$new_manifest"
      continue
    fi

    old_sum=$(awk -v r="$rel" '$2==r {print $1}' "$manifest" 2>/dev/null | head -1)
    if [ "$cur_sum" = "$old_sum" ]; then
      if ! install_default "$src" "$dst"; then
        echo "[init] ERROR: $app/$rel: install_default failed; skipping (keeping old manifest entry)" >&2
        awk -v r="$rel" '$2==r {print $0}' "$manifest" 2>/dev/null | head -1 >> "$new_manifest"
        continue
      fi
      printf '%s  %s\n' "$new_sum" "$rel" >> "$new_manifest"
    else
      echo "[init] $app/$rel was edited locally; image default written to $rel.new"
      if ! install_default "$src" "$dst.new"; then
        echo "[init] ERROR: $app/$rel: install_default for $rel.new failed; skipping (keeping old manifest entry)" >&2
        awk -v r="$rel" '$2==r {print $0}' "$manifest" 2>/dev/null | head -1 >> "$new_manifest"
        continue
      fi
      printf '%s  %s\n' "$new_sum" "$rel" >> "$new_manifest"
    fi
  done

  mv "$new_manifest" "$manifest" || echo "[init] ERROR: $app: cannot update manifest $manifest; skipping" >&2
done

# i3 would otherwise pop its first-run config wizard; seed the stock config instead.
if command -v i3 >/dev/null 2>&1 && [ ! -f "$HOME/.config/i3/config" ] && [ -f /usr/etc/i3/config ]; then
  if mkdir -p "$HOME/.config/i3" && install_default /usr/etc/i3/config "$HOME/.config/i3/config"; then
    :
  else
    echo "[init] ERROR: seeding $HOME/.config/i3/config failed; skipping" >&2
  fi
fi
chown -R abc:abc "$HOME/.config"

# ---- locale --------------------------------------------------------------
if [ -n "${LC_ALL:-}" ]; then
  export LANG="$LC_ALL"
  export LANGUAGE="${LC_ALL%.UTF-8}"
fi

# ---- hardening flags (subset of linuxserver's) ---------------------------
if [ "${HARDEN_DESKTOP:-false}" = "true" ]; then
  export DISABLE_SUDO=true DISABLE_TERMINALS=true DISABLE_OPEN_TOOLS=true
  : "${SELKIES_FILE_TRANSFERS=}"
  : "${SELKIES_COMMAND_ENABLED=false}"
  : "${SELKIES_UI_SIDEBAR_SHOW_FILES=false}"
  : "${SELKIES_UI_SIDEBAR_SHOW_APPS=false}"
  export SELKIES_FILE_TRANSFERS SELKIES_COMMAND_ENABLED SELKIES_UI_SIDEBAR_SHOW_FILES SELKIES_UI_SIDEBAR_SHOW_APPS
fi
if [ "${DISABLE_SUDO:-false}" = "true" ]; then
  log "disabling sudo"
  chmod 0000 /usr/local/bin/sudo
fi

# ---- nginx ---------------------------------------------------------------
CPORT="${CUSTOM_PORT:-3000}"
CHPORT="${CUSTOM_HTTPS_PORT:-3001}"
export CUSTOM_WS_PORT="${CUSTOM_WS_PORT:-8082}"
CUSER="${CUSTOM_USER:-abc}"
SFOLDER="${SUBFOLDER:-/}"
FILE_MANAGER_PATH="${FILE_MANAGER_PATH:-$HOME/Desktop}"
DASHBOARD="${DASHBOARD:-selkies-dashboard}"
SELKIES_FILE_TRANSFERS="${SELKIES_FILE_TRANSFERS-upload,download}"

if [ ! -f /config/ssl/cert.pem ]; then
  mkdir -p /config/ssl
  openssl req -new -x509 -days 3650 -nodes \
    -out /config/ssl/cert.pem -keyout /config/ssl/cert.key \
    -subj "/C=US/ST=CA/L=Carlsbad/O=Selkies/OU=Nix Selkies/CN=*" >/dev/null 2>&1
  chmod 600 /config/ssl/cert.key
  chown -R abc:abc /config/ssl
fi

NGINX_SITE=/run/nginx/default.conf
cp /defaults/nginx-default.conf "$NGINX_SITE"
sed -i "s/3000/$CPORT/g; s/3001/$CHPORT/g; s/CWS/$CUSTOM_WS_PORT/g" "$NGINX_SITE"
sed -i "s|SUBFOLDER|$SFOLDER|g; s|REPLACE_DOWNLOADS_PATH|$FILE_MANAGER_PATH|g" "$NGINX_SITE"
s6-setuidgid abc mkdir -p "$FILE_MANAGER_PATH"
if [[ "${SELKIES_FILE_TRANSFERS,,}" != *"download"* ]] || [ "${HARDEN_DESKTOP:-false}" = "true" ]; then
  sed -i '/files {/,/^  }/d' "$NGINX_SITE"
fi
if [ -n "${DISABLE_IPV6:-}" ]; then
  sed -i '/listen \[::\]/d' "$NGINX_SITE"
fi
if [ -n "${PASSWORD:-}" ]; then
  printf '%s:%s\n' "$CUSER" "$(openssl passwd -apr1 "$PASSWORD")" > /run/nginx/.htpasswd
  sed -i 's/#//g' "$NGINX_SITE"
fi
sed "s|@MIME_TYPES@|$(dirname "$(readlink -f "$(command -v nginx)")")/../conf/mime.types|" \
  /defaults/nginx.conf > /run/nginx/nginx.conf

# ---- dashboard -----------------------------------------------------------
rm -rf /run/selkies/web
cp -a "/usr/share/selkies/$DASHBOARD/." /run/selkies/web/ 2>/dev/null || cp -rL "/usr/share/selkies/$DASHBOARD/." /run/selkies/web/
chmod -R u+w /run/selkies/web
sed -i "s|REPLACE_DOWNLOADS_PATH|$FILE_MANAGER_PATH|g" /run/selkies/web/nginx/footer.html
cp /usr/share/selkies/www/icon.png /run/selkies/web/favicon.ico
cp /usr/share/selkies/www/icon.png /run/selkies/web/icon.png
cat > /run/selkies/web/manifest.json <<MANIFEST
{
  "name": "${TITLE:-Selkies}",
  "short_name": "${TITLE:-Selkies}",
  "manifest_version": 2,
  "version": "1.0.0",
  "display": "fullscreen",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [ { "src": "icon.png", "type": "image/png", "sizes": "180x180" } ],
  "start_url": "${SFOLDER}"
}
MANIFEST
chown -R abc:abc /run/selkies/web

# ---- GPU device permissions ----------------------------------------------
for dev in $(find /dev/dri -type c 2>/dev/null); do
  gid=$(stat -c '%g' "$dev")
  if ! id -G abc | grep -qw "$gid"; then
    gname=$(getent group "$gid" | cut -d: -f1)
    if [ -z "$gname" ]; then
      gname="video$gid"
      groupadd -g "$gid" "$gname"
    fi
    usermod -a -G "$gname" abc
    log "added abc to group $gname for $dev"
  fi
done
if [ -e /dev/dri/renderD128 ] && [ ! -e /dev/dri/renderD129 ] && [ -z "${DRI_NODE+x}" ]; then
  export DRI_NODE=/dev/dri/renderD128
fi

# ---- NVIDIA driver shims --------------------------------------------------
# The NVIDIA container toolkit injects the host driver into /usr/local/lib, a
# path a Nix-built image does not search: its GL stack lives under
# /run/opengl-driver/lib and carries Mesa only. The EGL ICD the toolkit drops in
# (10_nvidia.json) names "libEGL_nvidia.so.0" with no path, so the loader never
# finds it and everything silently falls back to software.
#
# Four things have to be true, and a library path alone is not enough:
#
#   1. libEGL_nvidia.so.0 is loadable   -> LD_LIBRARY_PATH
#
#   2. GBM can find the nvidia backend  -> GBM_BACKENDS_PATH pointing at a
#      directory holding a backend named "nvidia-drm_gbm.so".
#
#      That backend is libnvidia-allocator.so.1 -- it is the library exporting
#      gbmint_get_backend, which is the symbol GBM dlsym()s. It is emphatically
#      NOT libnvidia-egl-gbm.so.1, which exports loadEGLExternalPlatform and is
#      the EGL external platform for item 3 below. Pointing nvidia-drm_gbm.so at
#      libnvidia-egl-gbm.so.1 fails in a maximally confusing way: EGL and the GL
#      renderer both come up on the NVIDIA GPU, and only buffer allocation dies,
#      because GBM rejects the backend for missing gbmint_get_backend and quietly
#      falls through to Mesa's dri_gbm.so on an NVIDIA render node --
#
#        [Wayland] Initializing GL Renderer using device: /dev/dri/renderD128
#        [Wayland] GPU Initialization failed: Failed to allocate GBM buffer.
#                  Falling back to Software Renderer (Pixman).
#
#      Rather than hardcode a library name, take the toolkit's own answer: it
#      already drops a correct /usr/local/lib/gbm/nvidia-drm_gbm.so symlink.
#
#   3. EGL knows about the external GBM platform     -> 15_nvidia_gbm.json
#   4. EGL knows about the external Wayland platform -> 10_nvidia_wayland.json
#
#      Both are egl_external_platform.d entries that the toolkit does not inject
#      (on Ubuntu they ship in libnvidia-egl-wayland/-gbm, which a Nix image has
#      no equivalent of). Without item 4, EGL_WL_bind_wayland_display is missing
#      and pixelflux cannot bind EGL to the Wayland display.
if [ -e /usr/local/lib/libEGL_nvidia.so.0 ]; then
  log "nvidia driver detected in /usr/local/lib; wiring EGL/GBM shims"
  export LD_LIBRARY_PATH="/usr/local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

  mkdir -p /run/nvidia-shim/gbm /run/nvidia-shim/egl_external_platform.d

  # GBM_BACKENDS_PATH REPLACES the default search path, it does not extend it,
  # so the shim directory has to carry Mesa's backends too. Without this, Mesa
  # can no longer find its own dri_gbm.so and GBM fails harder than it did
  # before any of this ran:
  #   MESA-LOADER: failed to open dri: /run/nvidia-shim/gbm/dri_gbm.so
  #   [Wayland] GPU Initialization failed: Failed to create Raw GBM Device.
  for backend in /run/opengl-driver/lib/gbm/*.so; do
    [ -e "$backend" ] || continue
    ln -sf "$backend" "/run/nvidia-shim/gbm/$(basename "$backend")"
  done

  # NVIDIA's GBM backend, preferring the toolkit's own symlink over a guess.
  gbm_backend=
  for backend in /usr/local/lib/gbm/nvidia-drm_gbm.so /usr/local/lib/libnvidia-allocator.so.1; do
    [ -e "$backend" ] || continue
    gbm_backend=$(readlink -f "$backend")
    break
  done
  if [ -n "$gbm_backend" ]; then
    ln -sf "$gbm_backend" /run/nvidia-shim/gbm/nvidia-drm_gbm.so
    log "nvidia gbm backend: $gbm_backend"
  else
    log "WARNING: no nvidia gbm backend found; rendering will fall back to software"
  fi

  # EGL external platforms: <priority>:<library>.
  for platform in 15:libnvidia-egl-gbm.so.1 10:libnvidia-egl-wayland.so.1; do
    prio=${platform%%:*}; soname=${platform#*:}
    [ -e "/usr/local/lib/$soname" ] || continue
    name=$(echo "$soname" | sed 's/^libnvidia-egl-/nvidia_/; s/\.so.*$//')
    cat > "/run/nvidia-shim/egl_external_platform.d/${prio}_${name}.json" <<JSON
{
    "file_format_version" : "1.0.0",
    "ICD" : {
        "library_path" : "/usr/local/lib/$soname"
    }
}
JSON
  done

  export GBM_BACKENDS_PATH=/run/nvidia-shim/gbm
  export __EGL_EXTERNAL_PLATFORM_CONFIG_DIRS=/run/nvidia-shim/egl_external_platform.d
  chmod -R a+rX /run/nvidia-shim
fi

# ---- gamepad passthrough -------------------------------------------------
mkdir -pm1777 /dev/input 2>/dev/null || true
if [ -z "${NO_GAMEPAD+x}" ] && { mknod /dev/input/js0 c 13 0 2>/dev/null || touch /dev/input/js0 2>/dev/null; }; then
  for i in 1 2 3; do mknod /dev/input/js$i c 13 $i 2>/dev/null || touch /dev/input/js$i; done
  for i in 0 1 2 3; do mknod /dev/input/event100$i c 13 $((1064+i)) 2>/dev/null || touch /dev/input/event100$i; done
  chmod 777 /dev/input/js* /dev/input/event100* 2>/dev/null || true
  export LD_PRELOAD="/usr/local/lib/selkies_joystick_interposer.so:/opt/lib/libudev.so.1.0.0-fake"
  log "virtual gamepads enabled"
else
  export SELKIES_UI_SIDEBAR_SHOW_GAMEPADS=false SELKIES_GAMEPAD_ENABLED=false
  export SELKIES_ENABLE_PLAYER2=false SELKIES_ENABLE_PLAYER3=false SELKIES_ENABLE_PLAYER4=false
fi

touch /tmp/selkies_js.log
chmod 777 /tmp/selkies* 2>/dev/null || true

# ---- hand off to s6 ------------------------------------------------------
rm -rf /run/service/*
cp -r /etc/s6/service/. /run/service/
mkdir -p /run/service/.s6-svscan
cat > /run/service/.s6-svscan/finish <<'FIN'
#!/bin/sh
exit 0
FIN
chmod +x /run/service/.s6-svscan/finish

log "starting services"
exec s6-svscan /run/service
