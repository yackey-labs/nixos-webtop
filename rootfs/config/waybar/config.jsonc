// Waybar for the Hyprland webtop. One bar, no tray clutter, no heavy modules.
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 6,

  // Tap targets first. Every keybind in hyprland.conf needs SUPER, and phone
  // on-screen keyboards do not have a Super key at all -- verified on iOS, and
  // the Selkies pop-over keyboard's own Super button does not pass through
  // either (it fails identically on the niri desktop, which shares none of this
  // stack, so it is a Selkies limitation rather than something fixable here).
  // Without these three buttons a phone can move the pointer and type but can
  // never open or close a window.
  "modules-left": ["custom/term", "custom/menu", "custom/close", "hyprland/workspaces", "hyprland/window"],

    // \u escape rather than a literal glyph: the first attempt shipped an
  // empty format because the raw codepoint was lost in transit, so the
  // button rendered as zero-width and invisible while still being present.
  "custom/term":  { "format": "\uf120", "tooltip": false, "on-click": "ghostty" },
  "custom/menu":  { "format": "󰀻", "tooltip": false, "on-click": "fuzzel" },
  "custom/close": { "format": "󰅖", "tooltip": false, "on-click": "hyprctl dispatch killactive" },

  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "pulseaudio", "tray"],

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "1": "󰎤", "2": "󰎧", "3": "󰎪", "4": "󰎭", "5": "󰎱",
      "default": "󰧞", "active": "󰮯"
    }
  },
  "hyprland/window": { "format": "{title}", "max-length": 48, "separate-outputs": true },
  "clock": {
    "format": "󰥔  {:%H:%M}",
    "format-alt": "󰃭  {:%a %d %b}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "cpu":    { "format": "󰻠  {usage}%", "interval": 5 },
  "memory": { "format": "󰍛  {percentage}%", "interval": 5 },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  muted",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },
  "tray": { "spacing": 8 }
}
